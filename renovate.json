{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "apm"
  ],
  "packageRules": [
    {
      "description": "Group non-major APM updates",
      "matchManagers": [
        "apm"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "labels": ["dependencies", "apm"],
      "groupName": "APM dependencies"
    },
    {
      "description": "Require approval for APM major updates",
      "matchManagers": [
        "apm"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "labels": ["dependencies", "apm"],
      "dependencyDashboardApproval": true
    }
  ]
}